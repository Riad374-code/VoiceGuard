# Copy to .env and fill in real keys. .env is gitignored and baked into
# BuildConfig at build time, so a built APK needs no extra setup.
# Pipeline: on-device Deepgram STT + Groq llama scoring, backend WS optional.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
DEEPGRAM_API_KEY=
# Legacy alias for DEEPGRAM_API_KEY (either name works)
DEEPGRAM_SST=
DEEPGRAM_MODEL=nova-3
# Optional live-analysis backend. Emulator default; real devices need a public wss:// URL
# or change it in-app under Settings -> Analysis server.
BACKEND_WS_URL=wss://your-backend.com/ws/audio-stream
